generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("ORGANIZER")
  createdAt    DateTime @default(now())
updatedAt DateTime @default(now()) @updatedAt

  checkins Guest[] @relation("CheckedInBy")
}

model Party {
  id          String   @id
  seatNumber  Int?
  inviteNumber String?
  partySize   Int?
  tripleName  String?

  createdAt   DateTime @default(now())
updatedAt DateTime @default(now()) @updatedAt

  guests Guest[]
}

model Guest {
  id          Int      @id @default(autoincrement())
  partyId     String
  party       Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  guestName   String
  seatNumber  Int?
  inviteNumber String?
  tripleName  String?
  partySize   Int?
  memberIndex Int?

  checkinToken String  @unique
  qrPayload    String?
  qrFile       String?

  checkedInAt   DateTime?
  checkedInById Int?
  checkedInBy   User?   @relation("CheckedInBy", fields: [checkedInById], references: [id])

  createdAt   DateTime @default(now())
updatedAt DateTime @default(now()) @updatedAt
}
